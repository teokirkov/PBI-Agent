/// Auto date/time is disabled below (annotation __PBI_TimeIntelligenceEnabled
/// = 0) - the model has an explicit Date table marked as the date table, and
/// the hidden auto date/time tables would be redundant and waste RAM.
model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation __PBI_TimeIntelligenceEnabled = 0

	annotation PBI_ProTooling = ["DevMode"]

	annotation PBI_QueryOrder = ["DatabricksHost","DatabricksHttpPath","DatabricksCatalog","DatabricksSchema","DatabricksBiTasks","fnParseMoney","stgColor","stgSupplierCategory","stgStockItem","Sales","Customer","Product","Category","Bridge Product Category","Supplier","Package Type"]

ref table 'Sales'
ref table 'Date'
ref table 'Customer'
ref table 'Product'
ref table 'Category'
ref table 'Bridge Product Category'
ref table 'Supplier'
ref table 'Package Type'
ref table _Measures
