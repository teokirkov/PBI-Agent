/// One row per product stock-group tag (9 rows), derived from the distinct
/// values across Warehouse Stock Item's CategoryName1/2/3.
///
/// IMPORTANT: a product carries 1 to 3 of these tags, so this dimension
/// deliberately OVERLAPS. Each individual category's Total Sales is correct,
/// but the category subtotals add up to about 1.63x the grand total because
/// multi-tagged products are counted under each of their tags. That is normal
/// for tag analysis, and it is why Power BI's total row will not equal the sum
/// of the rows. For a breakdown that must reconcile, use
/// Dim Product[Category Group] instead. Full reasoning: docs/decisions/0004
/// and projects/bi-task-1/ANALYSIS.md.
table 'Dim Category'

	/// Source columns: CategoryName1, CategoryName2, CategoryName3 (unioned).
	/// Clothing, Computing Novelties, Furry Footwear, Mugs, Novelty Items,
	/// Packaging Materials, T-Shirts, Toys, USB Novelties.
	column Category
		dataType: string
		sourceColumn: Category
		summarizeBy: none

	partition 'Dim Category' = m
		mode: import
		queryGroup: Model\Dimensions
		source =
				let
					Source = stgStockItem,
					// The three category columns hold values from one shared
					// domain, so the dimension is their union, not one of them.
					CombinedValues = List.Combine({Source[CategoryName1], Source[CategoryName2], Source[CategoryName3]}),
					DistinctValues = List.Distinct(List.RemoveNulls(CombinedValues)),
					SortedValues = List.Sort(DistinctValues, Order.Ascending),
					ConvertedToTable = Table.FromList(SortedValues, Splitter.SplitByNothing(), {"Category"}),
					TypedColumns = Table.TransformColumnTypes(ConvertedToTable, {{"Category", type text}}),
					Result = TypedColumns
				in
					Result

	annotation PBI_ResultType = Table

