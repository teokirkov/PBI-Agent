/// All relationships are many (fact or bridge) to one (dimension), and all are
/// single-direction except the one bridge relationship called out below.
/// Cardinality and cross-filtering are left at the TMDL defaults
/// (many-to-one, one direction) wherever that is what is wanted, so anything
/// stated explicitly here is a deliberate departure.

/// Order Date is the model's single analytical date. The fact table also
/// carried invoice, transaction and finalization dates, but all three are
/// derivable from each other and within a day of the order date, so there are
/// no role-playing date relationships to manage (docs/decisions/0007).
relationship Sales_OrderDate_to_Date
	fromColumn: 'Sales'.'Order Date'
	toColumn: 'Date'.Date

relationship Sales_to_Customer
	fromColumn: 'Sales'.'Customer ID'
	toColumn: 'Customer'.'Customer ID'

relationship Sales_to_Product
	fromColumn: 'Sales'.'Stock Item ID'
	toColumn: 'Product'.'Stock Item ID'

/// Direct fact-to-dimension rather than snowflaked through Product, per
/// docs/decisions/0006. Sales.SupplierID is identical to
/// StockItem.SupplierID on all 212,774 rows, so both shapes give the same
/// answer; this one keeps the star flat.
relationship Sales_to_Supplier
	fromColumn: 'Sales'.'Supplier ID'
	toColumn: 'Supplier'.'Supplier ID'

/// Also direct, per docs/decisions/0006. Sales.PackageTypeID matches
/// StockItem.UnitPackageID (not OuterPackageID) on all 212,774 rows.
relationship Sales_to_PackageType
	fromColumn: 'Sales'.'Package Type ID'
	toColumn: 'Package Type'.'Package Type ID'

/// The only bidirectional relationship in the model, and a deliberate one.
/// A product carries 1-3 category tags, so Category reaches Sales via
/// Category -> Bridge -> Product -> Sales. The Bridge -> Product hop has to
/// filter *back up* into Product for that path to work, which
/// single-direction cannot do.
///
/// Why this is safe rather than the usual bidirectional trap: the bridge
/// touches only Category and Product, never the fact, so there is no
/// filter loop and no ambiguous path. Total Sales at the grand total stays
/// correct (GBP 162,950,104.45).
///
/// What it does NOT protect against: category subtotals overlap by design and
/// sum to roughly 1.63x the grand total, because multi-tagged products count
/// under each tag. See Category's description, docs/decisions/0004, and
/// ANALYSIS.md. This relationship must be spot-checked in Desktop against
/// those numbers before the report is published.
relationship BridgeProductCategory_to_Product
	fromColumn: 'Bridge Product Category'.'Stock Item ID'
	toColumn: 'Product'.'Stock Item ID'
	crossFilteringBehavior: bothDirections

relationship BridgeProductCategory_to_Category
	fromColumn: 'Bridge Product Category'.Category
	toColumn: 'Category'.Category

